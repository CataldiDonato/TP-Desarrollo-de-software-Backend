# Copiá este archivo como .env y completá los datos de tu base PostgreSQL.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restoflow"

# Clave para firmar los tokens de login (JWT). Usá un texto largo y difícil de adivinar.
JWT_SECRET=cambiar_por_una_clave_secreta

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Dominios que pueden usar la API, separados por coma (opcional).
# En desarrollo se deja vacío; en producción va la URL del frontend deployado.
# CORS_ORIGIN=https://restoflow.vercel.app

# Mercado Pago (Checkout Pro)
# Access Token de la app: TEST-... en desarrollo, APP_USR-... en producción.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (panel de MP → Webhooks). Sirve para validar la firma.
MP_WEBHOOK_SECRET=
# URL pública del backend, a donde MP manda el webhook (MP no acepta localhost).
PUBLIC_API_URL=
# URL del frontend, a donde MP devuelve al cliente después de pagar.
FRONTEND_URL=
